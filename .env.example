# Copy this file to .env and fill in your values
OPENAI_API_KEY=sk-...
MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.3
LOG_LEVEL=INFO
# Optional: USD per 1M tokens for the cost monitor (overrides the built-in price table)
# OPENAI_PRICE_INPUT_PER_1M=0.15
# OPENAI_PRICE_OUTPUT_PER_1M=0.60

# ── Options signal tool (options/) — see docs/index-options-plan.md, Appendices A and C ──
# Zerodha Kite Connect app (developers.kite.trade). KITE_USER_ID = your Zerodha client ID.
KITE_API_KEY=
KITE_API_SECRET=
KITE_USER_ID=
# Telegram: token from @BotFather; chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Postgres on Railway (reference ${{Postgres.DATABASE_URL}}); defaults to a local SQLite file
# DATABASE_URL=sqlite:///data/options.db
# OPTIONS_INDICES=["NIFTY"]
# OPTIONS_CAPITAL=100000
# OPTIONS_RISK_PER_TRADE_PCT=3
# OPTIONS_DAILY_LOSS_STOP_PCT=10
